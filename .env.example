# Copie para .env.local e preencha as chaves dos serviços que você usa.
# O setup: npm run tools:setup

# Agency OS — widget (tenant abmsol). Origem muda quando o subdomínio entrar.
# NEXT_PUBLIC_AGENCYOS_ORIGIN=https://chat.abmsol.com.br
# NEXT_PUBLIC_AGENCYOS_PUBLIC_KEY=pk_…

# 21st.dev — busca/instala componentes React (MCP + CLI)
# https://21st.dev/settings/api-keys
API_KEY_21ST=

# Originkit — componentes stack-aware (MCP HTTP)
# https://mcp.originkit.dev/
ORIGINKIT_API_KEY=

# Skiper UI Pro — registry @skiper-ui (shadcn CLI + MCP shadcn)
# https://skiper-ui.com/docs/quick-start
SKIPER_LICENSE_KEY=

# Unlumen UI Pro — registry @unlumen-ui
# https://unlumen-ui-docs.vercel.app/docs/mcp
UNLUMEN_LICENSE_KEY=

# React Bits Pro — registries @reactbits-starter e @reactbits-pro
# https://pro.reactbits.dev/docs/installation
REACTBITS_LICENSE_KEY=

# MotionSites, GetLayers, Motion AI Kit: OAuth no primeiro uso — sem chave aqui.
# Cult UI: open source via @cult-ui — sem chave.
